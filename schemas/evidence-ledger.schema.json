{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogniumhq/a11y-benchmark/schemas/evidence-ledger.schema.json",
  "title": "Accessibility benchmark evidence ledger",
  "description": "Execution and verification evidence for enumerated test-space values. A value named by a fixture is represented; it becomes executed only when a record here says a runner or protocol actually produced evidence for it, and verified only when a reviewer or an independent reproduction confirmed that evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "format_version", "generated", "policy", "records"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "format": { "const": "cognium-a11y-evidence-ledger" },
    "format_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "generated": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiry", "independence"],
      "properties": {
        "expiry": { "type": "string", "minLength": 1 },
        "independence": { "type": "string", "minLength": 1 }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "value",
        "state",
        "runner",
        "environment",
        "artifact",
        "reproduction_class",
        "captured_against",
        "recorded_on"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$" },
        "dimension": {
          "enum": ["surfaces", "journeys", "ui-states", "user-needs", "input-at", "methods"]
        },
        "value": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["executed", "verified"],
          "description": "Only these two states are recorded. Represented and executable are derived from the corpus itself and can never be asserted here."
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "version"],
          "properties": {
            "kind": { "enum": ["automated-harness", "human-protocol", "assistive-technology"] },
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "protocol_version": { "type": "string", "minLength": 1 }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "runtime"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "minLength": 1 },
            "browser": { "type": "string", "minLength": 1 },
            "browser_version": { "type": "string", "minLength": 1 },
            "assistive_technology": { "type": "string", "minLength": 1 },
            "assistive_technology_version": { "type": "string", "minLength": 1 }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "sha256"],
          "properties": {
            "type": { "enum": ["benchmark-result", "human-result", "double-review", "ci-log"] },
            "uri": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "reproduction_class": {
          "enum": ["maintainer", "vendor", "independent", "academic"],
          "description": "Who produced the evidence. Vendor evidence is never reported as independent reproduction."
        },
        "reviewer": { "type": "string", "minLength": 1 },
        "captured_against": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corpus_content_digest"],
          "properties": {
            "corpus_content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "corpus_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "scoring_policy": { "type": "string", "minLength": 1 }
          }
        },
        "recorded_on": { "type": "string", "format": "date" },
        "superseded_by": {
          "type": "string",
          "minLength": 1,
          "description": "Id of the record that replaces this one, for a harness or environment change the corpus digest cannot detect."
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "description": "A verified record must name who confirmed it.",
          "if": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
          "then": { "properties": { "reviewer": {} }, "required": ["reviewer"] }
        }
      ]
    }
  }
}
