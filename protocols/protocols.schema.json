{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogniumhq/a11y-benchmark/protocols/protocols.schema.json",
  "title": "Human and assistive-technology protocol registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "format_version", "result_vocabulary", "privacy", "protocols"],
  "properties": {
    "$schema": { "const": "./protocols.schema.json" },
    "format": { "const": "cognium-a11y-human-protocols" },
    "format_version": { "const": "1.0.0" },
    "result_vocabulary": {
      "const": ["pass", "fail", "inapplicable", "cannot-tell", "not-tested"]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_data", "participant_data", "production_evidence"],
      "properties": {
        "fixture_data": { "const": "public-synthetic-only" },
        "participant_data": { "const": "prohibited" },
        "production_evidence": { "const": "prohibited" }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocol" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "title", "lane", "fixture_ids", "prerequisites",
        "environment", "steps", "expected_observations", "stop_conditions",
        "evidence_requirements"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "const": "1.0.0" },
        "title": { "type": "string", "minLength": 1 },
        "lane": { "enum": ["human-guided", "at-interoperability", "user-task"] },
        "fixture_ids": { "$ref": "#/$defs/nonEmptyStrings" },
        "prerequisites": { "$ref": "#/$defs/nonEmptyStrings" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_fields", "pairing_options"],
          "properties": {
            "required_fields": { "$ref": "#/$defs/nonEmptyStrings" },
            "pairing_options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "tool", "platform", "browser", "input_method", "scope_note"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "tool": { "type": "string", "minLength": 1 },
                  "platform": { "type": "string", "minLength": 1 },
                  "browser": { "type": "string", "minLength": 1 },
                  "input_method": { "type": "string", "minLength": 1 },
                  "scope_note": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action", "expected_observation", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "action": { "type": "string", "minLength": 1 },
              "expected_observation": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "expected_observations": { "$ref": "#/$defs/nonEmptyStrings" },
        "stop_conditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence_requirements": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
