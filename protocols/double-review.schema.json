{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogniumhq/a11y-benchmark/protocols/double-review.schema.json",
  "title": "Independent double-review comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "format_version", "protocol", "reviews", "comparison", "privacy"],
  "properties": {
    "$schema": { "const": "../double-review.schema.json" },
    "format": { "const": "cognium-a11y-double-review" },
    "format_version": { "const": "1.0.0" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "const": "1.0.0" }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "independent", "decisions"],
        "properties": {
          "reviewer_id": { "type": "string", "pattern": "^reviewer-[a-z0-9-]+$" },
          "independent": { "const": true },
          "decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step_id", "outcome"],
              "properties": {
                "step_id": { "type": "string", "minLength": 1 },
                "outcome": { "enum": ["pass", "fail", "inapplicable", "cannot-tell", "not-tested"] }
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_count", "agreement_count", "raw_agreement", "cohen_kappa", "forced_consensus", "disagreements"],
      "properties": {
        "decision_count": { "type": "integer", "minimum": 1 },
        "agreement_count": { "type": "integer", "minimum": 0 },
        "raw_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
        "cohen_kappa": { "type": "number", "minimum": -1, "maximum": 1 },
        "forced_consensus": { "const": false },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "reviewer_a", "reviewer_b", "resolution"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "reviewer_a": { "type": "string", "minLength": 1 },
              "reviewer_b": { "type": "string", "minLength": 1 },
              "resolution": { "enum": ["unresolved", "documented-separate", "adjudicated"] }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_ids_are_pseudonymous", "participant_data_included", "production_evidence_included"],
      "properties": {
        "reviewer_ids_are_pseudonymous": { "const": true },
        "participant_data_included": { "const": false },
        "production_evidence_included": { "const": false }
      }
    }
  }
}
