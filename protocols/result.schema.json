{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogniumhq/a11y-benchmark/protocols/result.schema.json",
  "title": "Human and assistive-technology evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "format_version", "corpus", "protocol", "session", "outcomes", "privacy", "metrics"],
  "properties": {
    "$schema": { "const": "../result.schema.json" },
    "format": { "const": "cognium-a11y-human-result" },
    "format_version": { "const": "1.0.0" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "manifest_sha256"],
      "properties": {
        "repository": { "const": "cogniumhq/a11y-benchmark" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "manifest_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fixture_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "const": "1.0.0" },
        "fixture_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "started_at", "completed_at", "environment"],
      "properties": {
        "reviewer_id": { "type": "string", "pattern": "^reviewer-[a-z0-9-]+$" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "tool_version", "browser", "browser_version", "platform", "platform_version", "settings", "input_method"],
          "properties": {
            "tool": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "tool_version": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "browser": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "browser_version": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "platform": { "type": "string", "minLength": 1 },
            "platform_version": { "type": "string", "minLength": 1 },
            "settings": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              }
            },
            "input_method": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "outcome", "observation", "evidence"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["pass", "fail", "inapplicable", "cannot-tell", "not-tested"] },
          "observation": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "enum": ["note", "trace", "screenshot", "recording", "transcript", "digest"] },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "note": { "type": "string", "minLength": 1 }
              },
              "anyOf": [
                { "properties": { "digest": {} }, "required": ["digest"] },
                { "properties": { "note": {} }, "required": ["note"] }
              ]
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_data", "participant_data_included", "production_evidence_included"],
      "properties": {
        "fixture_data": { "const": "public-synthetic" },
        "participant_data_included": { "const": false },
        "production_evidence_included": { "const": false }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "automated_results_included"],
      "properties": {
        "lane": { "enum": ["human-guided", "at-interoperability", "user-task"] },
        "automated_results_included": { "const": false }
      }
    }
  }
}
